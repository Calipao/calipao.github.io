; Engine configuration file.
; Godot 4.7 project for the interactive desk on the portfolio home page.

config_version=5

[application]

config/name="Lin Xin Desk"
config/description="Interactive 3D desk with a terminal, embedded on the portfolio home page."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.047, 0.059, 0.055, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
